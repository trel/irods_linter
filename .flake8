[flake8]
max-line-length = 88
extend-ignore =
    E203,
    W503,
    D100,
    D101,
    D102,
    D103,
    D104,
    D105,
    D107

per-file-ignores =
    tests/*: D
    __init__.py: F401

docstring-convention = google
import-order-style = google
application-import-names = linter
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info
